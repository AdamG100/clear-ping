# What is kept out of the build context for docker/Dockerfile. BuildKit picks
# this file up by its name, so it applies even though the context is the
# repository root.

# Built inside the image, for the image's platform.
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Never bake a database or local settings into an image. `**/` because a bare
# pattern only matches at the top of the context, and a database can be
# anywhere CLEARPING_DB_PATH has pointed. The Dockerfile checks for the same
# files and fails the build if one gets through.
data
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db.*
**/*.bak
.env*

# Not needed to build.
.git
.github
.vscode
docs
*.md
