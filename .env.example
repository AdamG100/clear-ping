# Path to the SQLite database. Defaults to ./data/clearping.db
# CLEARPING_DB_PATH=./data/clearping.db

# Days of measurements to keep. Set to 0 to keep everything forever.
# CLEARPING_RETENTION_DAYS=90

# Set to 1 when running the prober as its own process (`npm run probe`),
# so the web app does not also schedule probes.
# CLEARPING_EXTERNAL_PROBER=1

# The Apprise program that sends alerts (pip install "apprise[all-plugins]"),
# when it is not on the PATH. The Docker image has it already.
# CLEARPING_APPRISE_BIN=/path/to/apprise

# Sign-in, and keys for scripts and assistants, are set up in the dashboard
# (Settings, the cog; see docs/security.md). Set this to off to get back in
# after losing a password: sign-in is not asked for, and a new account can be
# made, while it is set.
# CLEARPING_AUTH=off

# Under `npm run dev`, every page is opened signed in as the `dev` admin
# account (docs/running.md). Set to off to see the dashboard signed out.
# CLEARPING_DEV_USER=off

# The single assistant token from before keys were made in the dashboard. Still
# honoured, as a key that can change things; prefer keys made in Settings.
# CLEARPING_MCP_TOKEN=

# Set to 1 to take a key over plain HTTP from anywhere, for when a VPN or a
# tunnel does the encrypting. Otherwise it is taken only over HTTPS or from
# ClearPing's own network.
# CLEARPING_MCP_ALLOW_HTTP=1

# A PeeringDB API key (free, from your PeeringDB profile), for Routing to name
# the exchanges a route or trace crosses. Not needed, but PeeringDB turns away
# reads without one when they come often.
# CLEARPING_PEERINGDB_API_KEY=

# What sign-in cookies are signed with. Not needed: one is made at the first
# start and kept in the database. Set it to keep sessions across a database
# that is replaced.
# BETTER_AUTH_SECRET=
