# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# the probe agent's bundle and binary (npm run build:probe-agent), and the
# certificate it makes when run from here
/dist
/probe-agent-data

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: every one but the example, which holds no values and is what the
# docs point to
.env*
!.env.example

# settings Claude Code keeps for one machine
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
data/
*.db
*.db-shm
*.db-wal
